{
  "name": "repo-scout-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "repo-scout 产品前端：让陌生 GitHub 仓库快速变得可读",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.13.1",
    "element-plus": "2.13.0",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.0",
    "pinia": "3.0.3",
    "vue": "3.5.40",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.18.13",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "28.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.8",
    "@vercel/node": "3.2.27"
  }
}
